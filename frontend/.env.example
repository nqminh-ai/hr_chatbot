# Gemini is OFF by default. Keep this key on the server; never use NEXT_PUBLIC_.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Supabase configuration. Chat currently reads JSON, not Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; not used by the current chat runtime. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Authentication is fail-closed in production. Set true only for the public sample demo.
APPOTA_DEMO_MODE=
# Production mode: trusted-header. A trusted gateway must strip incoming x-appota-* headers,
# inject user ID/timestamp/signature, and keep this 32+ character secret server-side.
APPOTA_AUTH_MODE=
APPOTA_AUTH_SECRET=

# Per-instance defense-in-depth. Enforce a distributed quota at the gateway for multi-instance deployments.
APPOTA_RATE_LIMIT_MAX=20
APPOTA_RATE_LIMIT_WINDOW_SECONDS=60
